<div class="contact-bug" aria-hidden="false">
  <a class="contact-link" href="./contact" aria-label="Contact us">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M2 6.5A2.5 2.5 0 0 1 4.5 4h15A2.5 2.5 0 0 1 22 6.5v11A2.5 2.5 0 0 1 19.5 20h-15A2.5 2.5 0 0 1 2 17.5v-11z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M3 7.5l8.5 6L20 7.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="label">Contact</span>
  </a>
</div>

<style>
  .contact-bug {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 1100;
    font-family: Inter, Arial, sans-serif;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--brand-cta);
    color: #fff;
    padding: 12px;
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(15,23,42,0.18);
    text-decoration: none;
    font-weight: 800;
    transform-origin: center;
    transition: max-width 0.22s ease, transform 0.12s ease, box-shadow 0.12s ease;
    max-width: 48px;
    overflow: hidden;
    white-space: nowrap;
  }

  .contact-link svg {
    display: block;
    color: #fff;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
  }

  .contact-link .label {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.95rem;
    vertical-align: middle;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(15,23,42,0.22);
    max-width: 220px;
  }

  .contact-link:hover .label,
  .contact-link:focus-visible .label {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 480px) {
    .contact-bug { right: 14px; bottom: 14px; }
    .contact-link { padding: 10px; max-width: 48px; }
    .contact-link .label { display: none; }
  }
</style>
