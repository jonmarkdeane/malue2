---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="home-hero">
  <div class="home-hero-content">
    <h1>{title}</h1>
    <div class="scroll">
      <a href="#start" class="skip-link">
        <!-- <p>Scroll to learn more</p> -->
        <span class="scroll-arrow" aria-hidden="true">🡇</span></a
      >
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    display: flex;
    width: 100%;
    justify-content: center;
    align-items: end;
    padding: 0 0 80px;
    overflow: hidden;
    isolation: isolate;
  }

  .home-hero-content {
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: row;
    width: min(100%, var(--site-max-width));
    padding: 0 var(--pad);
    color: var(--off-white);
  }

  h1 {
	display: flex;
    max-width: 18ch;
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 100px);
    font-weight: 600;
    line-height: 1.09;
  }
  .scroll {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-self: flex-end;
    color: var(--off-white);
  }

  @media screen and (max-width: 640px) {
	.home-hero-content {
	  flex-direction: column;
	  align-items: left;
	  gap: 24px;
	}
	.scroll {
	  align-self: flex-start;
	}
  }

  .scroll a {
    color: var(--off-white);
    text-decoration: none;
  }
  .scroll p {
    max-width: 9ch;
    margin: 0 0 8px;
    font-size: 1rem;
    line-height: 1.2;
    text-align: center;
  }

  .scroll-arrow {
    display: grid;
    width: 90px;
    height: 90px;
    flex: 0 0 130px;
    place-items: center;
    border-radius: 50%;
    background: rgba(250, 250, 250, 0.05);
    font-size: 3.5rem;
    line-height: 1;
    animation: scroll-pulse 2.4s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(250, 250, 250, 0.25);
    }

    50% {
      box-shadow: 0 0 0 14px rgba(250, 250, 250, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow {
      animation: none;
    }
  }
</style>
