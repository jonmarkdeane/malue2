---
import { Image } from "astro:assets";

interface Props {
  title: string;
  image: ImageMetadata;
  imageAlt?: string;
}

const { title, image, imageAlt = "" } = Astro.props;
---

<section class="home-hero">
  <Image class="home-hero-image" src={image} alt={imageAlt} loading="eager" />
  <div class="home-hero-content">
    <h1>{title}</h1>
    <div class="scroll">
		<a href="#start" class="skip-link">
      <!-- <p>Scroll to learn more</p> -->
      <span class="scroll-arrow" aria-hidden="true">🡇</span></a>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    display: flex;
    width: 100%;
    justify-content: center;
    align-items: end;
    min-height: calc(100svh - var(--news-strip-height));
    padding: 0 0 80px;
    overflow: hidden;
    background: #252525;
    isolation: isolate;
  }

  .home-hero-image {
    position: absolute;
    opacity: 0.4;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero-content {
    height: 100%;
    position: relative;
    display: flex;
    width: min(100%, var(--site-max-width));
    padding: 0 var(--site-gutter);
    color: var(--off-white);
    align-content: end;
  }

  .scroll {
	
	flex-grow: 1;
	display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    color: var(--off-white);
  }

  .scroll a {
color: var(--off-white);
	text-decoration: none;
  }
  .scroll p {
	max-width: 9ch;
    margin: 0 0 8px;
    font-size: 1rem;
    line-height: 1.2;
    text-align: center;
  }

  .scroll-arrow {
    display: grid;
    width: 90px;
    height: 90px;
    flex: 0 0 130px;
    place-items: center;
    border-radius: 50%;
    background: rgba(250, 250, 250, 0.05);
    font-size: 3.5rem;
    line-height: 1;
    animation: scroll-pulse 2.4s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(250, 250, 250, 0.25);
    }

    50% {
      box-shadow: 0 0 0 14px rgba(250, 250, 250, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow {
      animation: none;
    }
  }
  h1 {
flex-basis: 0;
min-width: 17ch;
    max-width: 18ch;
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 100px);
    font-weight: 600;
    line-height: 1.09;
  }
</style>
