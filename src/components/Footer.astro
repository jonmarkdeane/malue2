---
import { Image } from "astro:assets";
import logoWhite from "@assets/logo-white.svg";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Image class="footer-logo" src={logoWhite} alt="Malue" />
      <p class="footer-copy">
        Building an incentivised decision intelligence and adoption support
        ecosystem that turns collective experience into measurable improvement.
      </p>

      <div class="footer-addresses">
        <p>
          Registered Address: <br />
          Queen Street, <br />
          Leeds, <br />
          West Yorkshire, LS1 2TW, <br />
          United Kingdom.
        </p>
        <p>
          Development Office: <br />
          Harley House, <br />
          29 Cambray Place, Cheltenham, <br />
          GL50 1JN,<br />
          United Kingdom.
        </p>
      </div>
            <p class="footer-copy">
        Malue is a registered company in England and Wales (No. 14518792).
      </p>
      <p class="footer-copy">&copy; 2026 Malue Ltd. All rights reserved.</p>
    </div>
    <div class="footer-links">
      <div>
        <a href="#">Item</a>
        <a href="#">Item</a>
      </div>
      <div>
        <a href="./legal">Legal Notice</a>
        <a href="./privacy">Privacy Policy</a>
        <a href="./cookies">Cookie Notice</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    background: var(--dark-bg);
    color: var(--off-white);
    font-size: 0.8rem;
    font-weight: 100;
    line-height: 1.45;
  }

  .footer-inner {
    width: min(100%, var(--site-max-width));
    margin: 0 auto;
    padding: 80px 0;
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .footer-brand {
    max-width: 60%;
  }

  .footer-addresses {
    display: flex;
    width: 100%;
    flex-direction: row;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .footer-addresses p {
    min-width: 240px;
    margin: 0;
  }

  .footer-logo {
    display: block;
    width: 150px;
    height: auto;
    margin-bottom: 50px;
  }

  .footer-copy {
    text-wrap: balance;
    margin: 20px 0 0;
  }

  .footer-links {
    display: flex;
    gap: 44px;
    flex-wrap: wrap;
  }

  .footer-heading {
    margin: 0 0 12px;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .footer-links a {
    display: block;
    color: var(--off-white);
    text-decoration: none;
    margin-bottom: 8px;
    transition: color 0.2s ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: #1058ff;
  }

  @media screen and (max-width: 768px) {
    .footer-inner {
      padding: 24px 18px;
      flex-direction: column;
    }

    .footer-brand {
      max-width: 100%;
    }

    .footer-links {
      gap: 24px;
    }
  }
</style>
