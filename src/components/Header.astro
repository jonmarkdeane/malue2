---
import { Image } from "astro:assets";
import logo from "../assets/malue-logo-temp.svg";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";

interface Props {
  showNewsStrip?: boolean;
  newsMessage?: string;
  newsLinkText?: string;
  newsHref?: string;
  showHero?: boolean;
  heroTitle?: string;
  heroImage?: ImageMetadata;
}

const {
  showNewsStrip = false,
  newsMessage,
  newsLinkText,
  newsHref,
  showHero = false,
  heroTitle,
  heroImage,
} = Astro.props;
---

<header class:list={["site-header", { "site-header--with-hero": showHero }]}>
  {
    showHero && (
      <Image
        class="home-hero-image"
        src={heroImage!}
        alt="hero animation"
        loading="eager"
      />
    )
  }

  {
    showNewsStrip && (
      <aside class="news-strip" aria-label="News">
        {newsMessage}{" "}
        <a href={newsHref}>
          <span>{newsLinkText}</span>
        </a>
      </aside>
    )
  }
  <div class="page-top">
    <div class="header-wrapper">
      <a class="logo" href="./">
        <Image src={logo} alt="Malue logo" width={200} />
      </a>

      <Nav />
    </div>
    <div class="hero-area">
      {showHero && heroTitle && heroImage && <Hero title={heroTitle} />}
    </div>
  </div>
</header>

<style>
  .site-header--with-hero {
    height: 100svh;
  }
  .site-header {
    background: none;
    color: var(--off-black);
    display: flex;
    flex-direction: column;
    z-index: 20;
    width: 100%;
    padding: 0;
  }
  .site-header--with-hero {
    background: var(--off-black);
    color: var(--off-white);
  }
  .home-hero-image {
    position: absolute;
    opacity: 0.4;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-top {
    z-index: 2;
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
  }

  .hero-area {
    display: flex;
    flex-grow: 0;
    flex-direction: column;
    justify-content: flex-end;
    flex-grow: 1;
  }

  .header-wrapper {
    display: flex;
    align-items: center;
    align-content: center;
    justify-content: space-between;
    gap: 20px;
    width: min(100%, var(--site-max-width));
    margin: 0;
    padding: var(--pad);
  }

  .site-header--with-hero .header-wrapper {
    z-index: 1;
    margin-inline: auto;
  }

  .logo {
    display: inline-flex;
    text-decoration: none;
  }

  .logo img {
    display: block;
    width: auto;
    height: 50px;
  }

  @media screen and (max-width: 768px) {
    .logo img {
      height: 40px;
    }
  }

  .news-strip {
    z-index: 3;
    padding: 12px;
    background: #000;
    color: var(--off-white);
    font-size: 0.9rem;
  }

  .news-label {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .news-strip a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .news-strip a span::after {
    content: "→";
    display: inline-block;
    margin-left: 4px;
  }

  ,
  @media screen and (max-width: 640px) {
    .news-strip {
      align-items: flex-start;
      flex-direction: column;
      gap: 2px;
      padding-block: 8px;
    }
  }
</style>
