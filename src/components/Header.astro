---
import { Image } from "astro:assets";
import logo from "../assets/malue-logo-temp.svg";
import Nav from "./Nav.astro";
---

<header class="site-header">
  <div class="header-wrapper">
    <a class="logo" href="./">
      <Image src={logo} alt="Malue logo" width={200} />
    </a>

    <Nav />
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: var(--news-strip-height);
    left: 0;
    z-index: 20;
    width: 100%;
    background: transparent;
    padding: 0 80px;
  }
   @media screen and (max-width: 768px) {
    .site-header {
      padding: 0 40px;
    }
    @media screen and (max-width: 480px) {
      .site-header {
        padding: 0 20px;
      }
    }
  .header-wrapper {
    display: flex;
    align-items: center;
    align-content: center;
    justify-content: space-between;
    gap: 20px;
    position: relative;
    width: min(100%, var(--site-max-width));
    margin: 0 auto;
    padding: 60px 0;
  }

  .logo {
    display: inline-flex;
    text-decoration: none;
  }

  .logo img {
    display: block;
    width: auto;
    height: 50px;
  }

  @media screen and (max-width: 768px) {
    .logo img {
      height: 40px;
    }
  }
</style>
