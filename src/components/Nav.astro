  <input
    type="checkbox"
    id="menu-toggle"
    aria-label="Toggle navigation menu"
  />
  <label for="menu-toggle" class="menu-button" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </label>

  <nav class="nav-menu" aria-label="Primary navigation">
    <div class="nav-links">
      <details class="nav-group">
        <summary class="nav-link nav-summary"><a href="./about">About</a></summary>
        <div class="submenu-panel">
          <a href="./about#why-malue-exists" class="dropdown-link">Why Malue exists</a>
          <a href="./about#managment-team" class="dropdown-link">Management Team</a>
          <a href="./about#our-values" class="dropdown-link">Our values</a>
        </div>
      </details>      <details class="nav-group">
        <summary class="nav-link nav-summary"><a href="./what-we-do">What we do</a></summary>
        <div class="submenu-panel">
          <a href="./whatwedo" class="dropdown-link">Overview</a>
          <a href="./whatwedo#services" class="dropdown-link">Services</a>
          <a href="./whatwedo#outcomes" class="dropdown-link">Outcomes</a>
        </div>
      </details>
      <details class="nav-group">
        <summary class="nav-link nav-summary"><a href="./how-we-work">How we work</a></summary>
        <div class="submenu-panel">
          <a href="./how-we-work#who-malue-supports" class="dropdown-link">Who Malue supports</a>
          <a href="./how-we-work#in-the-real-world" class="dropdown-link">In the real world</a>
        </div>
      </details>
      <details class="nav-group">
        <summary class="nav-link nav-summary"><a href="./investors">Investors</a></summary>
        <div class="submenu-panel">
          <a href="./investors#why-this-matters" class="dropdown-link">Why this matters</a>
          <a href="./investors#why-malue" class="dropdown-link">Why Malue?</a>
          <a href="./investors#our-platform" class="dropdown-link">Our platform</a>
          <a href="./investors#why-this-is-different" class="dropdown-link">Why this is different</a>
          <a href="./investors#why-now" class="dropdown-link">Why now?</a>
          <a href="./investors#built-through-verification" class="dropdown-link">Built through verification</a>
          <a href="./investors#our-vision" class="dropdown-link">Our vision</a>
          <a href="./investors#investment-highlights" class="dropdown-link">Investment highlights</a>
        </div>
      </details>
    </div>
    <a href="/contact" class="cta-button">Partner With Us</a>
  </nav>
</div>

<style>
  input#menu-toggle {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .menu-button {
    display: none;
    width: 40px;
    height: 32px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    background: transparent;
    position: relative;
  }

  .menu-button span {
    display: block;
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: #111827;
  }

  .nav-container {
    position: relative;
    width: 100%;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 24px;
    flex: 1;
    min-width: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex: 1;
    min-width: 0;
  }

  .nav-link a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .nav-group {
    position: relative;
  }

  .nav-summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 1px;
    position: relative;
  }

  .nav-summary::after {
    content: '▾';
    font-size: 1.6rem;
    display: inline-block;
    transform: translateY(1px);
    color: var(--brand-accent);
  }

  .nav-group[open] .nav-summary::after {
    transform: translateY(1px) rotate(180deg);
  }

  .nav-summary::-webkit-details-marker {
    display: none;
  }

  .submenu-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px;
    background: white;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    box-shadow: 0 22px 45px rgba(15, 23, 42, 0.12);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    min-width: 270px;
  }

  @media (hover: hover) and (min-width: 769px) {
    .nav-group:hover .submenu-panel,
    .nav-group:focus-within .submenu-panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  .nav-group[open] .submenu-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .dropdown-link {
    text-decoration: none;
    color: #475569;
    font-size: 0.95rem;
    padding: 8px 0;
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    text-decoration: none;
  }

  .nav-link {
    text-decoration: none;
    color: #334155;
    font-weight: 500;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-summary:hover,
  .nav-summary:focus-visible {
    color: #334155;
    text-decoration: none;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--brand-cta);
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .cta-button:hover,
  .cta-button:focus-visible {
    background: #b5b5b5;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 960px) {
    .menu-button {
      display: flex;
    }

    .nav-menu {
      position: absolute;
      top: calc(100% + 14px);
      right: 0;
      left: 0;
      flex-direction: column;
      gap: 12px;
      padding: 16px 18px;
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid rgba(15, 23, 42, 0.08);
      border-radius: 18px;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
      z-index: 30;
    }

    .nav-container {
      display: flex;
      justify-content: flex-end;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .nav-link,
    .nav-summary {
      width: 100%;
      display: inline-flex;
      justify-content: space-between;
      padding: 12px 0;
    }

    .cta-button {
      width: 100%;
      justify-content: center;
    }

    .nav-group {
      position: static;
    }

    .submenu-panel {
      position: static;
      transform: none;
      opacity: 1;
      pointer-events: auto;
      border: none;
      box-shadow: none;
      padding: 0;
      background: transparent;
      min-width: unset;
    }

    .nav-summary {
      padding: 0;
    }

    input#menu-toggle:checked + .menu-button + .nav-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }
</style>

<script type="module">
  if (typeof window !== 'undefined') {
    const initNavGroups = () => {
      const containers = document.querySelectorAll('.nav-container');

      containers.forEach(container => {
        const groups = Array.from(container.querySelectorAll('details.nav-group'));
        const menuToggle = container.querySelector('#menu-toggle');

        const closeMenu = () => {
          groups.forEach(group => {
            group.open = false;
          });

          if (menuToggle) {
            menuToggle.checked = false;
          }
        };

        groups.forEach(group => {
          group.addEventListener('toggle', () => {
            if (group.open) {
              groups.forEach(otherGroup => {
                if (otherGroup !== group) {
                  otherGroup.open = false;
                }
              });
            }
          });
        });

        container.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            closeMenu();
          });
        });

        document.addEventListener('click', (event) => {
          if (!container.contains(event.target)) {
            closeMenu();
          }
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNavGroups);
    } else {
      initNavGroups();
    }
  }
</script>

