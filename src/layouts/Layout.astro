---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Head from "@components/Head.astro";
import "@styles/global.css";

interface Props {
  showNewsStrip?: boolean;
  newsMessage?: string;
  newsLinkText?: string;
  newsHref?: string;
  showHero?: boolean;
  heroTitle?: string;
  heroImage?: ImageMetadata;
}

const {
  showNewsStrip = true,
  newsMessage,
  newsLinkText,
  newsHref,
  showHero = false,
  heroTitle,
  heroImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <Head />
  <body>
    <Header
      showNewsStrip={showNewsStrip}
      newsMessage={newsMessage}
      newsLinkText={newsLinkText}
      newsHref={newsHref}
      showHero={showHero}
      heroTitle={heroTitle}
      heroImage={heroImage}
    />
    <main id="start">
        <slot />
    </main>

    <Footer />

  </body>
</html>