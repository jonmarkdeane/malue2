---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Head from "@components/Head.astro";
import homeHero from "../assets/heroes/temphero.png";
import Hero from "@components/Hero.astro";
import NewsStrip from "@components/NewsStrip.astro";
import "@styles/global.css";
---

<!doctype html>
<html lang="en">
  <Head />
  <body>
    <NewsStrip
    message = "Malue is moving from research and validation towards commercial deployment, with adoption support at the centre of its platform model."
    linktext = "Read more"
    href = "#" />
    <Header />
    <Hero title="Helping healthcare adopt what works" image={homeHero} />
    <main id="start">
        <slot />
    </main>

    <Footer />

  </body>
</html>